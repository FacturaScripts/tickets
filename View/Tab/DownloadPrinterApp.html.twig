<div class="card shadow mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md">
                <p>{{ trans('connect-a-printer-p') }}</p>
                <div class="dropdown d-inline-block me-1">
                    <button class="btn btn-info dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false"><i class="fa-solid fa-download me-1"></i> {{ trans('download-app') }}
                    </button>
                    <div class="dropdown-menu">
                        <a class="dropdown-item"
                           href="https://github.com/FacturaScripts/fsprinter/releases/download/v1.5.0/FSPrinter.Setup.1.5.0.exe">
                            <i class="fa-brands fa-windows fa-fw me-1"></i> Windows 10/11 (64 bits)
                        </a>
                        <hr class="dropdown-divider">
                        <a class="dropdown-item"
                           href="https://github.com/FacturaScripts/fsprinter/releases/download/v1.5.0/FSPrinter-1.5.0-arm64.dmg">
                            <i class="fa-brands fa-apple fa-fw me-1"></i> Mac (.dmg)
                        </a>
                        <hr class="dropdown-divider">
                        <a class="dropdown-item"
                           href="https://github.com/FacturaScripts/fsprinter/releases/download/v1.5.0/fsprinter_1.5.0_amd64.deb">
                            <i class="fa-brands fa-linux fa-fw me-1"></i> Linux (.deb)
                        </a>
                        <a class="dropdown-item"
                           href="https://github.com/FacturaScripts/fsprinter/releases/download/v1.5.0/fsprinter-1.5.0.x86_64.rpm">
                            <i class="fa-brands fa-linux fa-fw me-1"></i> Linux (.rpm)
                        </a>
                        <a class="dropdown-item"
                           href="https://github.com/FacturaScripts/fsprinter/releases/download/v1.5.0/FSPrinter-1.5.0.AppImage">
                            <i class="fa-brands fa-linux fa-fw me-1"></i> Linux (.appImage)
                        </a>
                    </div>
                </div>
                <h1 class="h4 mt-5 mb-1">URL:</h1>
                <div class="d-flex align-items-center gap-2">
                    <code id="appUrl">{{ fsc.getAppUrl() }}</code>
                    <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('appUrl')" title="{{ trans('copy') }}">
                        <i class="fa-solid fa-copy"></i>
                    </button>
                </div>
                <h2 class="h4 mt-4 mb-1">{{ trans('api-key') }}:</h2>
                <div class="d-flex align-items-center gap-2">
                    <code id="appKey">{{ fsc.getAppKey() }}</code>
                    <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('appKey')" title="{{ trans('copy') }}">
                        <i class="fa-solid fa-copy"></i>
                    </button>
                </div>
                <h2 class="h4 mt-4 mb-1">{{ trans('websocket-channel') }}: …{{ fsprinterChannel() }}</h2>
                <div class="mt-2">
                    <button type="button" class="btn btn-outline-primary" id="testAppConnectionBtn" onclick="testFsPrinterConnection();">
                        <i class="fa-solid fa-wifi fa-fw me-1"></i> {{ trans('test-app-connection') }}
                    </button>
                    <div id="testAppConnectionResult" class="mt-2 small d-none"></div>
                </div>
                <div id="macWarning" class="alert alert-warning mt-3 mb-0 small d-none">
                    <i class="fa-brands fa-apple fa-fw me-1"></i>
                    <strong>Mac:</strong> {{ trans('mac-unsigned-binary-warning') }}
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <code id="macXattrCmd">xattr -dr com.apple.quarantine /Applications/FSPrinter.app</code>
                        <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('macXattrCmd')" title="{{ trans('copy') }}">
                            <i class="fa-solid fa-copy"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <img src="{{ asset('Dinamic/Assets/Images/printer-app.png') }}" alt="app" class="img-fluid"/>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(elementId) {
        const element = document.getElementById(elementId);
        const text = element.textContent;

        navigator.clipboard.writeText(text).then(function() {
            // Mostrar feedback visual
            const button = element.nextElementSibling;
            const originalHTML = button.innerHTML;
            button.innerHTML = '<i class="fa-solid fa-check"></i>';
            button.classList.remove('btn-outline-secondary');
            button.classList.add('btn-success');

            setTimeout(function() {
                button.innerHTML = originalHTML;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-secondary');
            }, 2000);
        }).catch(function(err) {
            console.error('Error al copiar al portapapeles:', err);
            alert('{{ trans('error-copying-to-clipboard') }}');
        });
    }

    // mostrar el aviso de Mac solo si el usuario está en un Mac
    document.addEventListener('DOMContentLoaded', function () {
        const platform = navigator.userAgentData ? navigator.userAgentData.platform : navigator.platform;
        if (/mac/i.test(platform)) {
            document.getElementById('macWarning').classList.remove('d-none');
        }
    });

    // comprueba, en sentido inverso al botón "Probar conexión" de la app fsprinter,
    // si la app está conectada y responde al canal websocket de esta instalación
    function testFsPrinterConnection() {
        const button = document.getElementById('testAppConnectionBtn');
        const result = document.getElementById('testAppConnectionResult');

        button.disabled = true;
        result.className = 'mt-2 small alert alert-secondary';
        result.textContent = '{{ trans('checking-app-connection') }}';

        fetch('{{ fsprinterWs() }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ action: 'ping' })
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('Error ' + response.status + ': ' + response.statusText);
                }
                return response.json();
            })
            .then(function () {
                result.className = 'mt-2 small alert alert-success';
                result.textContent = '{{ trans('app-connection-successful') }}';
            })
            .catch(function (error) {
                result.className = 'mt-2 small alert alert-danger';
                result.textContent = '{{ trans('app-connection-failed') }}: ' + error.message;
            })
            .finally(function () {
                button.disabled = false;
            });
    }
</script>